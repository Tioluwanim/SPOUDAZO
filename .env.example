# Database
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/spoudazo
DEBUG=true
SQLALCHEMY_ECHO=false

# Firebase Auth - base64-encode your service account JSON, see app/auth.py
# for the exact command (avoids multiline-JSON-in-.env problems)

FIREBASE_SERVICE_ACCOUNT_B64=
# Smart Library online resources - free tier at tavily.com, 1,000 searches/month,
# no card required. See app/services/web_search_service.py.
TAVILY_API_KEY=

# LLM router (already wired in app/services/ai_router.py)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT=60
OPENROUTER_RATE_LIMIT_DELAY=1

HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct:cerebras
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
HUGGINGFACE_TIMEOUT=60

# Embeddings
HF_MODEL_REPO=BAAI/bge-m3 
HF_TOKEN=
EMBEDDING_BACKEND=torch
EMBEDDING_DIMENSION=1024

# Chunking / retrieval
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MIN_CHUNK_LENGTH=50
TOP_K_RESULTS=6
SIMILARITY_THRESHOLD=0.2
CONTEXT_WINDOW_TOKENS=6000

# Misc
MAX_FILE_SIZE_MB=50
MAX_CHAT_HISTORY=20
TEMPERATURE=0.3
MAX_TOKENS=2000
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=1
RETRY_BACKOFF_FACTOR=2
RETRY_MAX_DELAY=30
ENABLE_CACHE=true
CACHE_TTL_SECONDS=3600
SHOW_DEBUG_INFO=false
