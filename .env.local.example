NEXT_PUBLIC_API_URL=http://localhost:8000

# Firebase client config - from Firebase Console > Project Settings > General
# > Your apps > Web app. These are safe to expose client-side (they identify
# the project, not a secret) - the actual security boundary is the ID token
# verification on the backend (see spoudazo-api's app/auth.py).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
